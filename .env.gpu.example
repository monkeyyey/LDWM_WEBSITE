# Reference template. setup.sh writes a fully expanded .env.gpu for this machine.
# The application reads .env.gpu automatically. Existing exported values win.
# Keep tokens in the Hugging Face login cache or process environment.
LDWM_ROOT="${LDWM_ROOT}"
LDWM_BACKEND_PYTHON="${LDWM_ROOT}/.venvs/backend/bin/python"
PYTHONDONTWRITEBYTECODE=1

SFWMARK_REPO="${LDWM_ROOT}/work/repos/SFWMark"
SFWMARK_PYTHON="${LDWM_ROOT}/.venvs/sfwmark/bin/python"
SFW_MODEL_ID=sd2-community/stable-diffusion-2-1-base
WATERMARK_GS_REPO="${LDWM_ROOT}/work/repos/Gaussian-Shannon"
WATERMARK_GS_PYTHON="${LDWM_ROOT}/.venvs/gaussian-shannon/bin/python"
WATERMARK_GS_MODEL_ID=sd2-community/stable-diffusion-2-1-base
WATERMARK_GSHADING_REPO="${LDWM_ROOT}/work/repos/Gaussian-Shading"
WATERMARK_GSHADING_PYTHON="${LDWM_ROOT}/.venvs/gaussian-shading/bin/python"
WATERMARK_GSHADING_MODEL_ID=sd2-community/stable-diffusion-2-1-base
WATERMARK_PRC_REPO="${LDWM_ROOT}/work/repos/PRC-Watermark"
WATERMARK_PRC_PYTHON="${LDWM_ROOT}/.venvs/prc-watermark/bin/python"
WATERMARK_PRC_MODEL_ID=sd2-community/stable-diffusion-2-1-base
WATERMARK_LAWA_REPO="${LDWM_ROOT}/work/repos/LaWa"
WATERMARK_LAWA_PYTHON="${LDWM_ROOT}/.venvs/lawa/bin/python"

WATERMARK_TREE_RING_PYTHON="${LDWM_ROOT}/.venvs/legacy/bin/python"
WATERMARK_RING_ID_PYTHON="${LDWM_ROOT}/.venvs/legacy/bin/python"
WATERMARK_GAUSSMARKER_PYTHON="${LDWM_ROOT}/.venvs/legacy/bin/python"
WATERMARK_ROBIN_PYTHON="${LDWM_ROOT}/.venvs/legacy/bin/python"
WATERMARK_WIND_PYTHON="${LDWM_ROOT}/.venvs/wind/bin/python"
WATERMARK_SEAL_PYTHON="${LDWM_ROOT}/.venvs/wind/bin/python"
WATERMARK_T2SMARK_PYTHON="${LDWM_ROOT}/.venvs/t2s/bin/python"
WATERMARK_TAG_WM_PYTHON="${LDWM_ROOT}/.venvs/tag/bin/python"
WATERMARK_SERUM_PYTHON="${LDWM_ROOT}/.venvs/serum/bin/python"

