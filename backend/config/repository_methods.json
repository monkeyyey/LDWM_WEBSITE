        "max": 200,
        "step": 1
      },
      "inversion_steps": {
        "label": "Inversion steps",
        "default": 50,
        "type": "number",
        "min": 1,
        "max": 200,
        "step": 1
      },
      "guidance_scale": {
        "label": "Guidance scale",
        "default": 7.5,
        "type": "number",
        "min": 0,
        "max": 30,
        "step": 0.5
      },
      "w_seed": {
        "label": "Watermark seed",
        "default": 999999,
        "type": "number",
        "min": 0,
        "max": 2147483647,
        "step": 1
      },
      "w_channel": {
        "label": "Latent channel",
        "default": 3,
        "type": "select",
        "choices": [
          -1,
          0,
          1,
          2,
          3
        ]
      },
      "w_radius": {
